{
  "tool": {
    "type": "function",
    "function": {
      "name": "isi_notulen_rapat",
      "description": "Isi notulen rapat dari catatan atau transkrip yang diberikan pengguna. Isi hanya dari informasi yang diberikan pengguna; bila ada field wajib yang tidak diketahui, tanyakan ke pengguna, jangan mengarang. Nomor dokumen, tanggal surat, total, pajak, dan persetujuan diisi otomatis oleh sistem.",
      "parameters": {
        "type": "object",
        "properties": {
          "judul_rapat": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "description": "Judul rapat."
          },
          "tanggal_rapat": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "description": "Format YYYY-MM-DD."
          },
          "waktu_mulai": {
            "type": "string",
            "pattern": "^\\d{2}:\\d{2}$",
            "description": "Format HH:MM (24 jam, WIB)."
          },
          "waktu_selesai": {
            "type": "string",
            "pattern": "^\\d{2}:\\d{2}$",
            "description": "Format HH:MM (24 jam, WIB)."
          },
          "tempat": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "description": "Ruang rapat atau tautan daring."
          },
          "pimpinan_rapat": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60,
            "description": "Nama pimpinan rapat."
          },
          "notulis": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60,
            "description": "Nama notulis."
          },
          "peserta": {
            "type": "array",
            "minItems": 1,
            "maxItems": 30,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80,
              "description": "Satu butir."
            },
            "description": "Nama (dan jabatan) peserta."
          },
          "agenda": {
            "type": "array",
            "minItems": 1,
            "maxItems": 10,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120,
              "description": "Satu butir."
            },
            "description": "Butir agenda."
          },
          "pembahasan": {
            "type": "array",
            "minItems": 1,
            "maxItems": 10,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "agenda",
                "ringkasan"
              ],
              "properties": {
                "agenda": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120,
                  "description": "Butir agenda."
                },
                "ringkasan": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 900,
                  "description": "Ringkasan diskusi."
                }
              }
            }
          },
          "keputusan": {
            "type": "array",
            "minItems": 0,
            "maxItems": 15,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300,
              "description": "Satu butir."
            },
            "description": "Keputusan rapat; kosongkan bila tidak ada."
          },
          "tindak_lanjut": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "tugas",
                "pic",
                "tenggat"
              ],
              "properties": {
                "tugas": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200,
                  "description": "Tugas."
                },
                "pic": {
                  "type": "string",
                  "minLength": 0,
                  "maxLength": 60,
                  "description": "Nama PIC; '' bila tidak disebut."
                },
                "tenggat": {
                  "type": "string",
                  "pattern": "^(\\d{4}-\\d{2}-\\d{2})?$",
                  "description": "YYYY-MM-DD; '' bila tidak disebut."
                }
              }
            }
          }
        },
        "required": [
          "judul_rapat",
          "tanggal_rapat",
          "waktu_mulai",
          "waktu_selesai",
          "tempat",
          "pimpinan_rapat",
          "notulis",
          "peserta",
          "agenda",
          "pembahasan",
          "keputusan",
          "tindak_lanjut"
        ],
        "additionalProperties": false
      }
    }
  },
  "field_program": {
    "nomor": "Nomor notulen",
    "tanggal": "Tanggal penandatanganan",
    "tanggal_rapat": "Format 'Hari, tanggal'",
    "pembahasan": "+ no",
    "tindak_lanjut": "+ no, catatan (mis. 'PIC belum ditentukan'), tenggat diformat",
    "peringatan": "Daftar peringatan"
  }
}