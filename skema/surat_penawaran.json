{
  "tool": {
    "type": "function",
    "function": {
      "name": "isi_surat_penawaran",
      "description": "Isi surat penawaran harga ke klien eksternal (kita yang menjual layanan/produk). Isi hanya dari informasi yang diberikan pengguna; bila ada field wajib yang tidak diketahui, tanyakan ke pengguna, jangan mengarang. Nomor dokumen, tanggal surat, total, pajak, dan persetujuan diisi otomatis oleh sistem.",
      "parameters": {
        "type": "object",
        "properties": {
          "nama_klien": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "description": "Nama organisasi klien."
          },
          "alamat_klien": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "description": "Alamat klien."
          },
          "up": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "description": "Nama/jabatan yang dituju (U.p.)."
          },
          "perihal": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "description": "Mis. 'Penawaran Pelatihan Generative AI untuk Tim Analitik'."
          },
          "pembuka": {
            "type": "string",
            "minLength": 40,
            "maxLength": 700,
            "description": "Paragraf pembuka: konteks kebutuhan klien dan apa yang ditawarkan."
          },
          "ruang_lingkup": {
            "type": "array",
            "minItems": 1,
            "maxItems": 10,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "description": "Satu butir."
            },
            "description": "Butir ruang lingkup pekerjaan."
          },
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 10,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "uraian",
                "jumlah",
                "satuan",
                "harga_satuan"
              ],
              "properties": {
                "uraian": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120,
                  "description": "Komponen yang ditawarkan."
                },
                "jumlah": {
                  "type": "integer",
                  "minimum": 1
                },
                "satuan": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 20,
                  "description": "Mis. paket, peserta, hari."
                },
                "harga_satuan": {
                  "type": "integer",
                  "minimum": 0,
                  "description": "Rupiah, bilangan bulat tanpa titik/koma, mis. 18500000."
                }
              }
            }
          },
          "masa_berlaku_hari": {
            "type": "integer",
            "minimum": 7,
            "maximum": 90
          },
          "syarat_pembayaran": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "description": "Mis. '50% di muka, 50% setelah BAST'."
          },
          "nama_penandatangan": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60,
            "description": "Nama penanda tangan."
          },
          "jabatan_penandatangan": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "description": "Jabatan penanda tangan."
          }
        },
        "required": [
          "nama_klien",
          "alamat_klien",
          "up",
          "perihal",
          "pembuka",
          "ruang_lingkup",
          "items",
          "masa_berlaku_hari",
          "syarat_pembayaran",
          "nama_penandatangan",
          "jabatan_penandatangan"
        ],
        "additionalProperties": false
      }
    }
  },
  "field_program": {
    "nomor": "Nomor surat keluar",
    "tanggal": "Tanggal surat",
    "lampiran": "Mis. '-'",
    "items": "+ no, harga diformat",
    "subtotal": "Rupiah",
    "ppn_persen": "Tarif PPN",
    "ppn": "Rupiah",
    "total": "Rupiah",
    "total_terbilang": "Terbilang",
    "ketentuan": "Masa berlaku (tanggal), syarat pembayaran, pajak"
  }
}