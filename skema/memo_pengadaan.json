{
  "tool": {
    "type": "function",
    "function": {
      "name": "isi_memo_pengadaan",
      "description": "Isi memo permintaan pengadaan barang/jasa internal (kita yang membeli dari vendor). Isi hanya dari informasi yang diberikan pengguna; bila ada field wajib yang tidak diketahui, tanyakan ke pengguna, jangan mengarang. Nomor dokumen, tanggal surat, total, pajak, dan persetujuan diisi otomatis oleh sistem.",
      "parameters": {
        "type": "object",
        "properties": {
          "unit_pemohon": {
            "type": "string",
            "enum": [
              "Divisi Data & AI",
              "Divisi Teknologi Informasi",
              "Divisi Keuangan",
              "Divisi SDM & Umum",
              "Divisi Pemasaran",
              "Divisi Operasional"
            ],
            "description": "Unit kerja pemohon."
          },
          "nama_pemohon": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60,
            "description": "Nama lengkap pemohon."
          },
          "jabatan_pemohon": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60,
            "description": "Jabatan pemohon, mis. 'Manajer Data Engineering'."
          },
          "perihal": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "description": "Ringkas apa yang dibeli, mis. 'Pengadaan 12 unit laptop untuk tim data'."
          },
          "jenis_pengadaan": {
            "type": "string",
            "enum": [
              "Barang",
              "Jasa lainnya",
              "Jasa konsultansi",
              "Pekerjaan konstruksi"
            ]
          },
          "latar_belakang": {
            "type": "string",
            "minLength": 40,
            "maxLength": 900,
            "description": "Alasan kebutuhan dan dampak bila tidak dipenuhi, 2–5 kalimat."
          },
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 15,
            "description": "Daftar barang/jasa.",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "uraian",
                "spesifikasi",
                "jumlah",
                "satuan",
                "harga_satuan"
              ],
              "properties": {
                "uraian": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80,
                  "description": "Nama barang/jasa."
                },
                "spesifikasi": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200,
                  "description": "Spesifikasi minimum."
                },
                "jumlah": {
                  "type": "integer",
                  "minimum": 1
                },
                "satuan": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 20,
                  "description": "Mis. unit, lisensi, paket, bulan."
                },
                "harga_satuan": {
                  "type": "integer",
                  "minimum": 0,
                  "description": "Rupiah, bilangan bulat tanpa titik/koma, mis. 18500000."
                }
              }
            }
          },
          "kebutuhan_tanggal": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "description": "Tanggal paling lambat barang/jasa dibutuhkan, YYYY-MM-DD."
          },
          "sumber_anggaran": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "description": "Mis. 'Anggaran Capex Divisi Data & AI 2026'."
          }
        },
        "required": [
          "unit_pemohon",
          "nama_pemohon",
          "jabatan_pemohon",
          "perihal",
          "jenis_pengadaan",
          "latar_belakang",
          "items",
          "kebutuhan_tanggal",
          "sumber_anggaran"
        ],
        "additionalProperties": false
      }
    }
  },
  "field_program": {
    "nomor": "Nomor memo sesuai SOP penomoran",
    "tanggal": "Tanggal memo (format Indonesia)",
    "kepada": "Penerima memo sesuai SOP (unit pengadaan)",
    "items": "Baris item + no, jumlah_harga (diformat)",
    "subtotal": "Rupiah terformat",
    "ppn_persen": "Tarif PPN",
    "ppn": "Rupiah terformat",
    "total": "Rupiah terformat",
    "total_terbilang": "Terbilang total",
    "metode_pengadaan": "Metode sesuai ambang nilai SOP",
    "min_penawaran": "Jumlah penawaran pembanding minimal",
    "dasar_metode": "Pasal SOP yang dipakai",
    "peringatan": "Daftar peringatan (mis. indikasi pemecahan paket)",
    "lampiran": "Checklist lampiran wajib sesuai metode",
    "persetujuan": "Rantai persetujuan [{tingkat, jabatan}]",
    "kebutuhan_tanggal": "Ditulis ulang ke format Indonesia"
  }
}